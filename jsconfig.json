{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "src/types.d.ts"]
}
