          <name>Not already paged</name>
          <sequenceNumber>7</sequenceNumber>
          <enabled>true</enabled>
          <operator>AND</operator>
          <script>var key = &apos;paged-&apos; + msg[&apos;OBR&apos;][&apos;OBR.3&apos;][&apos;OBR.3.1&apos;].toString();
if (globalChannelMap.containsKey(key)) return false;
globalChannelMap.put(key, true);
return true;</script>
        </com.mirth.connect.plugins.javascriptrule.JavaScriptRule>
        <com.mirth.connect.plugins.javascriptrule.JavaScriptRule version="4.7.0">
          <name>Critical flag (HH or LL)</name>
          <sequenceNumber>8</sequenceNumber>
          <enabled>true</enabled>
          <operator>AND</operator>
          <script>for each (var obx in msg..OBX) {
