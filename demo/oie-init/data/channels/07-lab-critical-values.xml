          <sequenceNumber>2</sequenceNumber>
          <enabled>true</enabled>
          <operator>AND</operator>
          <script>return msg[&apos;OBR&apos;][&apos;OBR.25&apos;][&apos;OBR.25.1&apos;].toString() == &apos;F&apos;;</script>
        </com.mirth.connect.plugins.javascriptrule.JavaScriptRule>
        <com.mirth.connect.plugins.rulebuilder.RuleBuilderRule version="4.7.0">
          <name>Has a value</name>
