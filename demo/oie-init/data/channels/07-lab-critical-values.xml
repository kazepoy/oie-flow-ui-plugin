          <name>Ordering provider known</name>
          <sequenceNumber>4</sequenceNumber>
          <enabled>true</enabled>
          <operator>AND</operator>
          <field>msg[&apos;OBR&apos;][&apos;OBR.16&apos;][&apos;OBR.16.1&apos;].toString()</field>
          <condition>EXISTS</condition>
          <values/>
        </com.mirth.connect.plugins.rulebuilder.RuleBuilderRule>
        <com.mirth.connect.plugins.javascriptrule.JavaScriptRule version="4.7.0">
          <name>Not a test patient</name>
          <sequenceNumber>5</sequenceNumber>
          <enabled>true</enabled>
          <operator>AND</operator>
          <script>return msg[&apos;PID&apos;][&apos;PID.3&apos;][&apos;PID.3.1&apos;].toString().indexOf(&apos;TEST&apos;) != 0;</script>
        </com.mirth.connect.plugins.javascriptrule.JavaScriptRule>
        <com.mirth.connect.plugins.javascriptrule.JavaScriptRule version="4.7.0">
          <name>Laboratory in scope</name>
          <sequenceNumber>6</sequenceNumber>
          <enabled>true</enabled>
          <operator>AND</operator>
          <script>var codes = [&apos;K&apos;, &apos;NA&apos;, &apos;GLU&apos;, &apos;HB&apos;, &apos;TROP&apos;];
