# Optional: copy to .env to customize compose.yaml values.

OIE_BIND_ADDRESS=127.0.0.1
OIE_HTTPS_PORT=8444
# Ports of the demo channels (MLLP and HTTP listeners).
OIE_CHANNEL_PORTS=8181-8199
TZ=Europe/Paris
OIE_JAVA_MAX_HEAP=1g

# Applied to admin creation and demo accounts on initialization.
OIE_PASSWORD=admin
OIE_DEMO_USER_PASSWORD=admin
OIE_SKIP_FIRST_LOGIN=true

# Database and keystore: set before first start.
POSTGRES_PASSWORD=demo-flow-ui-db
OIE_KEYSTORE_STOREPASS=demo-flow-ui-store
OIE_KEYSTORE_KEYPASS=demo-flow-ui-key
OIE_SERVER_ID=3f1c2b9e-6a4d-4e8b-9c1f-0d2e5a7b8c61

# Official OIE build options.
OIE_GRADLE_BUILD_ARGS=-PdisableSigning=true
