# Optional: copy to .env to change the values of compose.yaml.

# Reuse an OIE 4.7.0 engine image you already have instead of building it
# (the build takes several minutes), for example the FHIR Profile Mapper demo's:
# OIE_ENGINE_CONTEXT=docker-image://fhir-profile-mapper-demo-engine:4.7.0

OIE_BIND_ADDRESS=127.0.0.1
OIE_HTTPS_PORT=8444
# Ports of the demo channels (MLLP and HTTP listeners).
OIE_CHANNEL_PORTS=8181-8199
TZ=Europe/Paris

# The accounts and their passwords come from the demo database
# (every account: demo-oie-password).
# OIE_PASSWORD only applies when OIE starts on an empty database.
POSTGRES_PASSWORD=demo-flow-ui-db
OIE_KEYSTORE_STOREPASS=demo-flow-ui-store
OIE_KEYSTORE_KEYPASS=demo-flow-ui-key
