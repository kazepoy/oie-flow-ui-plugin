      "filter": {
        "@version": "4.7.0",
        "elements": {
          "com.mirth.connect.plugins.rulebuilder.RuleBuilderRule": [
            {
              "@version": "4.7.0",
              "name": "Is a result message",
              "enabled": true,
              "operator": "NONE",
              "field": "msg['MSH']['MSH.9']['MSH.9.1'].toString()",
              "condition": "EQUALS",
              "values": {
                "string": [
                  "'ORU'"
                ]
              },
              "sequenceNumber": "0"
            },
            {
              "@version": "4.7.0",
              "name": "Has observations",
              "enabled": true,
              "operator": "AND",
              "field": "msg['OBX'].toString()",
              "condition": "EXISTS",
              "values": "",
              "sequenceNumber": "1"
            },
            {
              "@version": "4.7.0",
              "name": "Has a value",
              "enabled": true,
              "operator": "AND",
              "field": "msg['OBX']['OBX.5']['OBX.5.1'].toString()",
              "condition": "EXISTS",
              "values": "",
              "sequenceNumber": "3"
            },
            {
              "@version": "4.7.0",
              "name": "Ordering provider known",
              "enabled": true,
              "operator": "AND",
              "field": "msg['OBR']['OBR.16']['OBR.16.1'].toString()",
              "condition": "EXISTS",
              "values": "",
              "sequenceNumber": "4"
            }
          ],
          "com.mirth.connect.plugins.javascriptrule.JavaScriptRule": [
            {
              "@version": "4.7.0",
              "name": "Final results only",
              "enabled": true,
              "operator": "AND",
              "script": "return msg['OBR']['OBR.25']['OBR.25.1'].toString() == 'F';",
              "sequenceNumber": "2"
            },
            {
              "@version": "4.7.0",
              "name": "Not a test patient",
              "enabled": true,
              "operator": "AND",
              "script": "return msg['PID']['PID.3']['PID.3.1'].toString().indexOf('TEST') != 0;",
              "sequenceNumber": "5"
            },
            {
              "@version": "4.7.0",
              "name": "Laboratory in scope",
              "enabled": true,
              "operator": "AND",
              "script": "var codes = ['K', 'NA', 'GLU', 'HB', 'TROP'];\nreturn codes.indexOf(msg['OBX']['OBX.3']['OBX.3.1'].toString()) >= 0;",
              "sequenceNumber": "6"
            },
            {
              "@version": "4.7.0",
              "name": "Not already paged",
              "enabled": true,
              "operator": "AND",
              "script": "var key = 'paged-' + msg['OBR']['OBR.3']['OBR.3.1'].toString();\nif (globalChannelMap.containsKey(key)) return false;\nglobalChannelMap.put(key, true);\nreturn true;",
              "sequenceNumber": "7"
            },
            {
              "@version": "4.7.0",
              "name": "Critical flag (HH or LL)",
              "enabled": true,
              "operator": "AND",
              "script": "for each (var obx in msg..OBX) {\n  var flag = obx['OBX.8']['OBX.8.1'].toString();\n  if (flag == 'HH' || flag == 'LL') return true;\n}\nreturn false;",
              "sequenceNumber": "8"
            }
          ]
        }
      },
      "transportName": "Channel Reader",
      "mode": "SOURCE",
      "enabled": true,
      "waitForPrevious": true
